# Caddy reverse-proxy configuration for portail.vitea-publica.tech
# Place this in /etc/caddy/Caddyfile (or include it from your main Caddyfile)
#
# Caddy will automatically provision a Let's Encrypt TLS certificate.
# After editing: sudo systemctl reload caddy

portail.vitea-publica.tech {
    encode zstd gzip

    # Optional security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Allow YouTube/Vimeo embeds
        Permissions-Policy "interest-cohort=()"
    }

    reverse_proxy 127.0.0.1:8006 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output file /var/log/caddy/vitea-publica.log
        format console
    }
}
